# ---- Data adapter ----
# json   : zero-dependency local store (file below). Default. Good for dev/demo.
# airtable : Airtable backend (MVP production). Requires the two keys below.
DATA_ADAPTER=json
DATA_FILE=./data/ecod.json

# ---- Airtable (only used when DATA_ADAPTER=airtable) ----
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ---- Sessions ----
# HMAC secret for session cookies. CHANGE THIS in any shared deployment.
SESSION_SECRET=ecod-dev-secret-change-me
